// Forward TE simulations for PhiTE validation.
//
// Requires SLiM 5.x.  Functional (m2) and disabled (m3) alleles with the
// same te_id are merged into one insertion-presence allele in the final
// sampled output.  MOVEMENT_MODE selects copy-and-paste or cut-and-paste.

function (integer) drawAvailableTEPositions(integer$ count, logical occupied)
{
    if (count == 0)
        return integer(0);

    available = size(occupied) - sum(occupied);
    if (count > available)
        stop("requested " + count + " TE destinations but only " +
            available + " positions are currently unoccupied");

    positions = integer(0);
    attempts = 0;
    attemptCap = max(POSITION_MIN_ATTEMPTS,
        asInteger(ceil(count * POSITION_ATTEMPT_FACTOR)));
    while ((size(positions) < count) & (attempts < attemptCap))
    {
        remaining = count - size(positions);
        batchSize = min(max(64, remaining * 2), attemptCap - attempts);
        candidates = unique(rdunif(batchSize, 0, CHROMOSOME_LENGTH - 1),
            preserveOrder=F);
        attempts = attempts + batchSize;
        candidates = candidates[!occupied[candidates]];
        if (size(candidates))
        {
            acceptedCount = min(remaining, size(candidates));
            accepted = candidates[seqLen(acceptedCount)];
            positions = c(positions, accepted);
            occupied[accepted] = T;
        }
    }

    if (size(positions) != count)
        stop("failed to allocate " + count + " TE destinations after " +
            attempts + " attempts; " + available + " positions were free");
    return positions;
}

initialize()
{
    initializeSLiMOptions(keepPedigrees=T, randomizeCallbacks=F);

    if (!exists("OUT_PREFIX"))
        defineConstant("OUT_PREFIX", "te_simulation");
    if (!exists("RANDOM_SEED"))
        defineConstant("RANDOM_SEED", getSeed());
    if (!exists("MOVEMENT_MODE"))
        defineConstant("MOVEMENT_MODE", "copy");
    if (!exists("POPULATION_SIZE"))
        defineConstant("POPULATION_SIZE", 500);
    if (!exists("CHROMOSOME_LENGTH"))
        defineConstant("CHROMOSOME_LENGTH", 3000000);
    if (!exists("BURNIN_TICKS"))
        defineConstant("BURNIN_TICKS", 5000);
    if (!exists("CHANGE_TICKS"))
        defineConstant("CHANGE_TICKS", 250);
    if (!exists("INITIAL_TE_COUNT"))
        defineConstant("INITIAL_TE_COUNT", 5000);
    if (!exists("SAMPLE_SIZE"))
        defineConstant("SAMPLE_SIZE", 25);
    if (!exists("NEUTRAL_MUTATION_RATE"))
        defineConstant("NEUTRAL_MUTATION_RATE", 1e-8);
    if (!exists("RECOMBINATION_RATE"))
        defineConstant("RECOMBINATION_RATE", 1e-8);
    if (!exists("TE_JUMP_RATE"))
        defineConstant("TE_JUMP_RATE", 1e-4);
    if (!exists("POST_BURNIN_MULTIPLIER"))
        defineConstant("POST_BURNIN_MULTIPLIER", 1.0);
    if (!exists("TE_DISABLE_RATE"))
        defineConstant("TE_DISABLE_RATE", 5e-5);
    if (!exists("TE_SELECTION_COEFF"))
        defineConstant("TE_SELECTION_COEFF", 0.0);
    if (!exists("TE_DOMINANCE"))
        defineConstant("TE_DOMINANCE", 0.5);
    if (!exists("POSITION_ATTEMPT_FACTOR"))
        defineConstant("POSITION_ATTEMPT_FACTOR", 100.0);
    if (!exists("POSITION_MIN_ATTEMPTS"))
        defineConstant("POSITION_MIN_ATTEMPTS", 1000);

    defineConstant("FINAL_TICK", BURNIN_TICKS + CHANGE_TICKS);

    if ((MOVEMENT_MODE != "copy") & (MOVEMENT_MODE != "cut"))
        stop("MOVEMENT_MODE must be 'copy' or 'cut'");
    if ((SAMPLE_SIZE < 1) | (SAMPLE_SIZE > POPULATION_SIZE))
        stop("SAMPLE_SIZE must be between 1 and POPULATION_SIZE");
    if ((POST_BURNIN_MULTIPLIER < 0.0) | (TE_JUMP_RATE < 0.0) |
        (TE_JUMP_RATE * POST_BURNIN_MULTIPLIER > 1.0))
        stop("TE movement probabilities must lie in [0, 1]");
    if ((TE_DISABLE_RATE < 0.0) | (TE_DISABLE_RATE > 1.0))
        stop("TE_DISABLE_RATE must lie in [0, 1]");
    if ((TE_DOMINANCE < 0.0) | (TE_DOMINANCE > 1.0))
        stop("TE_DOMINANCE must lie in [0, 1]");
    if (TE_SELECTION_COEFF <= -1.0)
        stop("TE_SELECTION_COEFF must be greater than -1");
    if ((NEUTRAL_MUTATION_RATE < 0.0) | (RECOMBINATION_RATE < 0.0) |
        (RECOMBINATION_RATE > 0.5))
        stop("neutral mutation and recombination rates are invalid");
    if ((POSITION_ATTEMPT_FACTOR <= 0.0) | (POSITION_MIN_ATTEMPTS < 1))
        stop("position-allocation attempt limits must be positive");
    if (INITIAL_TE_COUNT > CHROMOSOME_LENGTH)
        stop("INITIAL_TE_COUNT exceeds the number of available positions");
    if ((BURNIN_TICKS < 1) | (CHANGE_TICKS < 1))
        stop("BURNIN_TICKS and CHANGE_TICKS must both be positive");

    setSeed(RANDOM_SEED);
    initializeTreeSeq();

    // Neutral SNPs are overlaid after recapitation.  Keeping their mutation
    // rate at zero avoids millions of forward mutation objects.  The recorded
    // mutation-rate constant is consumed by the postprocessing stage.
    initializeRecombinationRate(RECOMBINATION_RATE);
    initializeMutationRate(0.0);
    initializeMutationType("m1", 0.5, "f", 0.0);  // postprocessing marker
    initializeGenomicElementType("g1", m1, 1.0);
    initializeGenomicElement(g1, 0, CHROMOSOME_LENGTH - 1);

    // Functional and disabled forms have the same fitness effect.  Disabling
    // changes mobility, not the selection coefficient of the insertion.
    initializeMutationType("m2", TE_DOMINANCE, "f", TE_SELECTION_COEFF);
    initializeMutationType("m3", TE_DOMINANCE, "f", TE_SELECTION_COEFF);
    m2.convertToSubstitution = F;
    m3.convertToSubstitution = F;
}

1 early()
{
    outputPaths = c(OUT_PREFIX + ".trees",
        OUT_PREFIX + ".parameters.tsv",
        OUT_PREFIX + ".samples.tsv",
        OUT_PREFIX + ".te_population.tsv",
        OUT_PREFIX + ".te_presence.tsv");
    completePath = OUT_PREFIX + ".complete";
    if (fileExists(completePath))
    {
        completion = readFile(completePath);
        if ((size(completion) == 1) & (completion[0] == "complete"))
            stop("refusing to overwrite completed output prefix: " +
                OUT_PREFIX);
        if (!deleteFile(completePath))
            stop("could not remove invalid completion marker: " +
                completePath);
    }

    // A preempted or failed final write has no completion marker.  Remove only
    // this model's known partial outputs so the exact task can be requeued.
    for (path in outputPaths)
        if (fileExists(path))
            if (!deleteFile(path))
                stop("could not remove incomplete output: " + path);

    sim.addSubpop("p1", POPULATION_SIZE);
    sim.tag = 0;  // next unused insertion ID
    community.rescheduleScriptBlock(s_finish, start=FINAL_TICK,
        end=FINAL_TICK);
}

1 late()
{
    // These source copies begin fixed, as in the SLiM TE recipe.  Because they
    // are shared by every haplotype, their selection coefficients do not
    // generate relative fitness differences.  New insertions do.
    haplosomes = sim.subpopulations.haplosomes;
    founderPositions = drawAvailableTEPositions(INITIAL_TE_COUNT,
        logical(CHROMOSOME_LENGTH));
    for (teIndex in seqLen(INITIAL_TE_COUNT))
    {
        position = founderPositions[teIndex];
        te = haplosomes.addNewDrawnMutation(m2, position);
        te.tag = sim.tag;
        te.setValue("insertionTick", community.tick);
        te.setValue("parentTE", -1);
        sim.tag = sim.tag + 1;
    }
}

s_index_disabled 1: first()
{
    // Keep only integer mutation IDs across callback boundaries.  Mutation
    // object references cannot safely be held long-term in Eidos dictionaries.
    disabledIndex = Dictionary();
    for (disabledTE in sim.mutationsOfType(m3))
        disabledIndex.setValue(disabledTE.tag, disabledTE.id);
    sim.setValue("disabledTEIndex", disabledIndex);
}

modifyChild()
{
    // Functional -> disabled is an allelic-state change at one insertion.
    // The te_id and the insertion's original tick are preserved.
    for (haplosome in child.haplosomes)
    {
        activeCount = haplosome.countOfMutationsOfType(m2);
        if (!activeCount)
            next;

        disableCount = rbinom(1, activeCount, TE_DISABLE_RATE);
        if (!disableCount)
            next;
        activeTEs = haplosome.mutationsOfType(m2);
        disabling = sample(activeTEs, disableCount);
        disabledIndex = sim.getValue("disabledTEIndex");
        for (activeTE in disabling)
        {
            disabledMutationID = disabledIndex.getValue(activeTE.tag);
            if (isNULL(disabledMutationID))
                sameInsertion = NULL;
            else
                sameInsertion = sim.subsetMutations(id=disabledMutationID);

            haplosome.removeMutations(activeTE);
            if (size(sameInsertion))
            {
                haplosome.addMutations(sameInsertion[0]);
            }
            else
            {
                disabledTE = haplosome.addNewDrawnMutation(m3,
                    activeTE.position);
                disabledTE.tag = activeTE.tag;
                disabledTE.setValue("insertionTick",
                    activeTE.getValue("insertionTick"));
                disabledTE.setValue("parentTE",
                    activeTE.getValue("parentTE"));
                disabledIndex.setValue(activeTE.tag, disabledTE.id);
            }
        }
    }
    return T;
}

s_transpose 1: late()
{
    if (community.tick > FINAL_TICK)
        return;

    jumpRate = TE_JUMP_RATE;
    if (community.tick > BURNIN_TICKS)
        jumpRate = jumpRate * POST_BURNIN_MULTIPLIER;

    if (jumpRate == 0.0)
        return;

    movingTEs = object();
    movingHaplosomes = object();
    for (individual in sim.subpopulations.individuals)
    {
        for (haplosome in individual.haplosomes)
        {
            activeCount = haplosome.countOfMutationsOfType(m2);
            if (!activeCount)
                next;

            moveCount = rbinom(1, activeCount, jumpRate);
            if (!moveCount)
                next;
            activeTEs = haplosome.mutationsOfType(m2);
            selectedTEs = sample(activeTEs, moveCount);
            movingTEs = c(movingTEs, selectedTEs);
            movingHaplosomes = c(movingHaplosomes,
                rep(haplosome, moveCount));
        }
    }

    moveCount = size(movingTEs);
    if (!moveCount)
        return;

    // Coordinates must be unique only among extant insertion loci and the
    // destinations allocated in this tick.  Positions of extinct insertions
    // may be reused.  A bitmap makes occupancy checks O(1), and the bounded
    // batch allocator fails explicitly instead of hanging near saturation.
    occupied = logical(CHROMOSOME_LENGTH);
    extantStates = c(sim.mutationsOfType(m2), sim.mutationsOfType(m3));
    if (size(extantStates))
        occupied[extantStates.position] = T;
    destinations = drawAvailableTEPositions(moveCount, occupied);

    for (eventIndex in seqLen(moveCount))
    {
        sourceTE = movingTEs[eventIndex];
        haplosome = movingHaplosomes[eventIndex];
        newTE = haplosome.addNewDrawnMutation(m2,
            destinations[eventIndex]);
        newTE.tag = sim.tag;
        newTE.setValue("insertionTick", community.tick);
        newTE.setValue("parentTE", sourceTE.tag);
        sim.tag = sim.tag + 1;

        // Copy-and-paste retains the source.  Cut-and-paste removes it only
        // from this haplotype; it may remain elsewhere.
        if (MOVEMENT_MODE == "cut")
            haplosome.removeMutations(sourceTE);
    }
}

s_finish 100000000 late()
{
    sampledIndividuals = sample(p1.individuals, SAMPLE_SIZE);
    sampledHaplosomes = NULL;
    sampleLines = c("sample_index\tindividual_pedigree_id\thaplosome_pedigree_id\thaplosome_subposition");
    sampleIndex = 1;
    for (individual in sampledIndividuals)
    {
        haplosome = sample(individual.haplosomes, 1);
        sampledHaplosomes = c(sampledHaplosomes, haplosome);
        sampleLines = c(sampleLines, paste(c(sampleIndex,
            individual.pedigreeID, haplosome.haplosomePedigreeID,
            haplosome.chromosomeSubposition), sep="\t"));
        sampleIndex = sampleIndex + 1;
    }

    activeTEs = sim.mutationsOfType(m2);
    disabledTEs = sim.mutationsOfType(m3);
    teIDs = integer(0);
    if (size(activeTEs))
        teIDs = c(teIDs, activeTEs.tag);
    if (size(disabledTEs))
        teIDs = c(teIDs, disabledTEs.tag);
    teIDs = sort(unique(teIDs));

    populationLines = c(paste(c("te_id", "parent_te_id", "position",
        "insertion_tick", "age", "functional_count", "disabled_count",
        "inserted_count", "inserted_frequency"), sep="\t"));

    presenceHeader = c("te_id", "position", "insertion_tick", "age",
        "sample_inserted_count");
    for (index in seqLen(SAMPLE_SIZE))
        presenceHeader = c(presenceHeader, "sample_" + (index + 1));
    presenceLines = c(paste(presenceHeader, sep="\t"));

    haplosomeCount = size(sim.subpopulations.haplosomes);
    for (teID in teIDs)
    {
        activeState = activeTEs[activeTEs.tag == teID];
        disabledState = disabledTEs[disabledTEs.tag == teID];
        if ((size(activeState) > 1) | (size(disabledState) > 1))
            stop("multiple mutation objects found for insertion " + teID);

        states = c(activeState, disabledState);
        position = states[0].position;
        if (size(activeState))
        {
            insertionTick = activeState[0].getValue("insertionTick");
            parentTE = activeState[0].getValue("parentTE");
            functionalCount = sim.mutationCounts(NULL, activeState[0]);
        }
        else
        {
            insertionTick = disabledState[0].getValue("insertionTick");
            parentTE = disabledState[0].getValue("parentTE");
            functionalCount = 0;
        }

        if (size(disabledState))
            disabledCount = sim.mutationCounts(NULL, disabledState[0]);
        else
            disabledCount = 0;

        insertedCount = functionalCount + disabledCount;
        age = community.tick - insertionTick;
        integerFields = paste(c(teID, parentTE, position, insertionTick, age,
            functionalCount, disabledCount, insertedCount), sep="\t");
        frequency = format("%.10f", insertedCount / haplosomeCount);
        populationLines = c(populationLines,
            integerFields + "\t" + frequency);

        sampleCalls = integer(0);
        for (haplosome in sampledHaplosomes)
            sampleCalls = c(sampleCalls,
                asInteger(any(haplosome.containsMutations(states))));
        sampleInsertedCount = sum(sampleCalls);
        if ((sampleInsertedCount > 0) &
            (sampleInsertedCount < SAMPLE_SIZE))
        {
            presence = c(teID, position, insertionTick, age,
                sampleInsertedCount, sampleCalls);
            presenceLines = c(presenceLines, paste(presence, sep="\t"));
        }
    }

    parameterLines = c("parameter\tvalue",
        "random_seed\t" + RANDOM_SEED,
        "movement_mode\t" + MOVEMENT_MODE,
        "population_size\t" + POPULATION_SIZE,
        "chromosome_length\t" + CHROMOSOME_LENGTH,
        "burnin_ticks\t" + BURNIN_TICKS,
        "change_ticks\t" + CHANGE_TICKS,
        "final_tick\t" + FINAL_TICK,
        "initial_te_count\t" + INITIAL_TE_COUNT,
        "sample_size\t" + SAMPLE_SIZE,
        "neutral_mutation_rate\t" + NEUTRAL_MUTATION_RATE,
        "recombination_rate\t" + RECOMBINATION_RATE,
        "te_jump_rate\t" + TE_JUMP_RATE,
        "post_burnin_multiplier\t" + POST_BURNIN_MULTIPLIER,
        "te_disable_rate\t" + TE_DISABLE_RATE,
        "te_selection_coeff\t" + TE_SELECTION_COEFF,
        "te_dominance\t" + TE_DOMINANCE,
        "position_attempt_factor\t" + POSITION_ATTEMPT_FACTOR,
        "position_min_attempts\t" + POSITION_MIN_ATTEMPTS);

    treeMetadata = Dictionary(
        "schema_version", "PhiTE-te-simulation-v1",
        "random_seed", RANDOM_SEED,
        "movement_mode", MOVEMENT_MODE,
        "population_size", POPULATION_SIZE,
        "chromosome_length", CHROMOSOME_LENGTH,
        "burnin_ticks", BURNIN_TICKS,
        "change_ticks", CHANGE_TICKS,
        "final_tick", FINAL_TICK,
        "initial_te_count", INITIAL_TE_COUNT,
        "sample_size", SAMPLE_SIZE,
        "neutral_mutation_rate", NEUTRAL_MUTATION_RATE,
        "recombination_rate", RECOMBINATION_RATE,
        "te_jump_rate", TE_JUMP_RATE,
        "post_burnin_multiplier", POST_BURNIN_MULTIPLIER,
        "te_disable_rate", TE_DISABLE_RATE,
        "te_selection_coeff", TE_SELECTION_COEFF,
        "te_dominance", TE_DOMINANCE,
        "te_presence_rule", "functional_or_disabled");

    // Write the tree sequence first, then checked tabular products, and place
    // the completion marker last.  A failed/preempted run has no marker and
    // its known partial outputs are removed safely when the task is requeued.
    sim.treeSeqRememberIndividuals(sampledIndividuals);
    sim.treeSeqOutput(OUT_PREFIX + ".trees", metadata=treeMetadata);

    if (!writeFile(OUT_PREFIX + ".parameters.tsv", parameterLines))
        stop("failed to write parameters table");
    if (!writeFile(OUT_PREFIX + ".samples.tsv", sampleLines))
        stop("failed to write sample table");
    if (!writeFile(OUT_PREFIX + ".te_population.tsv", populationLines))
        stop("failed to write TE population table");
    if (!writeFile(OUT_PREFIX + ".te_presence.tsv", presenceLines))
        stop("failed to write TE presence table");
    if (!writeFile(OUT_PREFIX + ".complete", "complete"))
        stop("failed to write completion marker");
    community.simulationFinished();
}
